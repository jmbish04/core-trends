---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/lib/config";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
---

<BaseLayout
  title={siteConfig.name}
  description={siteConfig.description}
>
  <div class="container mx-auto flex min-h-[calc(100vh-8rem)] flex-col items-center justify-center space-y-8 p-6">
    <div class="text-center space-y-4">
      <h1 class="text-5xl font-bold tracking-tight">Core Trends</h1>
      <p class="text-xl text-muted-foreground max-w-2xl">
        Repository Intelligence Platform powered by Cloudflare Workers AI
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-3 max-w-4xl w-full">
      <Card>
        <CardHeader>
          <CardTitle>Repository Dashboard</CardTitle>
          <CardDescription>View trending repositories with AI analysis</CardDescription>
        </CardHeader>
        <CardContent>
          <a href="/dashboard">
            <Button className="w-full">View Dashboard</Button>
          </a>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Pipeline Runs</CardTitle>
          <CardDescription>GitHub Actions pipeline execution history</CardDescription>
        </CardHeader>
        <CardContent>
          <a href="/pipeline">
            <Button className="w-full">View Runs</Button>
          </a>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>API Documentation</CardTitle>
          <CardDescription>Explore the API with Scalar docs</CardDescription>
        </CardHeader>
        <CardContent>
          <a href="/scalar" target="_blank">
            <Button className="w-full" variant="outline">View API Docs</Button>
          </a>
        </CardContent>
      </Card>
    </div>
  </div>
</BaseLayout>
